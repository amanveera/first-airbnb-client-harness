# Do not put your real API key in this file or commit it to Git.
# In your terminal, run: export OPENAI_API_KEY="your-key"
# Optional: choose a different supported OpenAI model.
OPENAI_MODEL=gpt-6-astra

# Used only by the hosted HasData Airbnb MCP server. Keep the real value in
# your terminal environment; never paste it into this file or chat.
HASDATA_API_KEY=your_hasdata_api_key_here
